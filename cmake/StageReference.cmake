function(sotn_generate_stage_reference output)
  set(manifest "${PROJECT_SOURCE_DIR}/config/stages-us.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(READ "${manifest}" reference)
  string(JSON region GET "${reference}" reference)
  if(NOT region STREQUAL "psx-us-slus-00067")
    message(FATAL_ERROR "Stage catalog must use the pinned US reference")
  endif()
  string(JSON count LENGTH "${reference}" stages)
  if(count LESS 1 OR count GREATER 128)
    message(FATAL_ERROR "Invalid stage catalog extent")
  endif()
  set(header "/* Public stage fingerprints only; no game bytes. */\nstatic const StageSpec reference_stages[] = {\n")
  math(EXPR last "${count} - 1")
  set(ids "")
  set(codes "")
  foreach(index RANGE ${last})
    string(JSON id GET "${reference}" stages ${index} id)
    string(JSON code GET "${reference}" stages ${index} code)
    if(NOT id MATCHES "^[0-9]+$" OR id GREATER 255 OR id IN_LIST ids OR
       NOT code MATCHES "^[A-Z][A-Z0-9][A-Z0-9][A-Z0-9]?$" OR code IN_LIST codes)
      message(FATAL_ERROR "Invalid or duplicate stage identity")
    endif()
    list(APPEND ids "${id}")
    list(APPEND codes "${code}")
    string(APPEND header "  {{${id}U, \"${code}\"},")
    foreach(kind overlay graphics)
      string(JSON path GET "${reference}" stages ${index} ${kind} path)
      string(JSON size GET "${reference}" stages ${index} ${kind} size)
      string(JSON hash GET "${reference}" stages ${index} ${kind} sha1)
      string(LENGTH "${hash}" hash_length)
      if(NOT path MATCHES "^(ST|BOSS)/${code}/(F_)?${code}\\.BIN$" OR
         NOT size MATCHES "^[1-9][0-9]*$" OR size GREATER 524288 OR
         NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 40)
        message(FATAL_ERROR "Invalid stage fingerprint ${code}/${kind}")
      endif()
      string(APPEND header " {\"${path}\", ${size}U, \"${hash}\"},")
    endforeach()
    string(APPEND header "},\n")
  endforeach()
  string(APPEND header "};\n")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${header}" @ONLY)
endfunction()
