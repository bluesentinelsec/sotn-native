function(sotn_generate_reference output)
  set(manifest "${PROJECT_SOURCE_DIR}/config/reference-us.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(READ "${manifest}" reference)
  string(JSON id GET "${reference}" id)
  if(NOT id MATCHES "^[a-z0-9-]+$")
    message(FATAL_ERROR "Invalid reference ID")
  endif()
  # This order matches SotnGameFileId, not the order of JSON object members.
  set(paths "SLUS_000.67" "DRA.BIN" "BIN/RIC.BIN" "ST/ST0/ST0.BIN" "ST/NZ0/NZ0.BIN")
  string(JSON count LENGTH "${reference}" files)
  string(JSON size_count LENGTH "${reference}" sizes)
  if(NOT count EQUAL 5 OR NOT size_count EQUAL 5)
    message(FATAL_ERROR "Expected five core reference files and sizes")
  endif()
  set(header "/* Generated from public reference metadata; contains no game data. */\n")
  string(APPEND header "#define SOTN_REFERENCE_ID \"${id}\"\n")
  string(APPEND header "static const SotnDataSpec reference_files[SOTN_GAME_FILE_COUNT] = {\n")
  foreach(path IN LISTS paths)
    string(JSON hash GET "${reference}" files "${path}")
    string(JSON size GET "${reference}" sizes "${path}")
    string(LENGTH "${hash}" hash_length)
    if(NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 40 OR
       NOT size MATCHES "^[1-9][0-9]*$" OR size GREATER 16777216)
      message(FATAL_ERROR "Invalid reference metadata for ${path}")
    endif()
    string(APPEND header "  {\"${path}\", ${size}U, \"${hash}\"},\n")
  endforeach()
  string(APPEND header "};\n")
  string(JSON resource_count LENGTH "${reference}" resources)
  if(NOT resource_count EQUAL 33)
    message(FATAL_ERROR "Expected thirty-three additional game resources")
  endif()
  string(APPEND header "static const SotnDataSpec reference_resources[SOTN_RESOURCE_COUNT] = {\n")
  set(resource_paths "ST/NZ0/F_NZ0.BIN" "BIN/F_GAME.BIN" "BIN/ARC_F.BIN"
    "SD_J010.VB" "VAB/SD_ALK.VH" "VAB/SD_ALK.VB"
    "ST/NZ0/SD_ZKNZ0.VH" "ST/NZ0/SD_ZKNZ0.VB" "BIN/WEAPON0.BIN" "BIN/F_GO.BIN" "F_MAP.BIN" "ST/NO3/SD_ZKNO3.VH" "ST/NO3/SD_ZKNO3.VB" "ST/NP3/SD_ZKNP3.VH" "ST/NP3/SD_ZKNP3.VB" "ST/NO0/SD_ZKNO0.VH" "ST/NO0/SD_ZKNO0.VB" "ST/NO1/SD_ZKNO1.VH" "ST/NO1/SD_ZKNO1.VB" "BOSS/BO4/SD_ZKBO4.VH" "BOSS/BO4/SD_ZKBO4.VB" "ST/LIB/SD_ZKLIB.VH" "ST/LIB/SD_ZKLIB.VB" "ST/LIB/SEQ_LIB.SEQ" "ST/DAI/SD_ZKDAI.VH" "ST/DAI/SD_ZKDAI.VB" "ST/DAI/SEQ_DAI.SEQ")
  list(APPEND resource_paths "BOSS/BO5/SD_ZKBO5.VH" "BOSS/BO5/SD_ZKBO5.VB")
  list(APPEND resource_paths "ST/NO2/SD_ZKNO2.VH" "ST/NO2/SD_ZKNO2.VB")
  list(APPEND resource_paths "BOSS/BO0/SD_ZKBO0.VH" "BOSS/BO0/SD_ZKBO0.VB")
  foreach(path IN LISTS resource_paths)
    string(JSON hash GET "${reference}" resources "${path}" sha1)
    string(JSON size GET "${reference}" resources "${path}" size)
    string(LENGTH "${hash}" hash_length)
    if(NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 40 OR
       NOT size MATCHES "^[1-9][0-9]*$" OR size GREATER 16777216)
      message(FATAL_ERROR "Invalid resource metadata for ${path}")
    endif()
    string(APPEND header "  {\"${path}\", ${size}U, \"${hash}\"},\n")
  endforeach()
  string(APPEND header "};\n")
  string(JSON stream_size GET "${reference}" streams "SD/XA_STR1." size)
  string(JSON stream_hash GET "${reference}" streams "SD/XA_STR1." sha1)
  string(LENGTH "${stream_hash}" stream_hash_length)
  if(NOT stream_hash MATCHES "^[0-9a-f]+$" OR NOT stream_hash_length EQUAL 40 OR
     NOT stream_size MATCHES "^[1-9][0-9]*$" OR stream_size GREATER 1073741824)
    message(FATAL_ERROR "Invalid streamed music reference metadata")
  endif()
  string(APPEND header "static const SotnDataSpec reference_music = {\"SD/XA_STR1.\", ${stream_size}U, \"${stream_hash}\"};\n")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${header}" @ONLY)
endfunction()
