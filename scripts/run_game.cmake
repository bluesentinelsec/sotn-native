cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED APP OR NOT EXISTS "${APP}")
  message(FATAL_ERROR "Game executable is missing; build sotn-native before launching")
endif()
set(game_data "$ENV{SOTN_GAME_DATA}")
if(game_data STREQUAL "")
  set(game_data "${CMAKE_CURRENT_LIST_DIR}/../local/game-data/us")
endif()
if(NOT IS_DIRECTORY "${game_data}")
  message(FATAL_ERROR "Private game-data directory is missing: ${game_data}. Set SOTN_GAME_DATA to your extracted US dump")
endif()
set(command "${APP}" --game-data "${game_data}" --entrance)
if(DEBUG_GAME)
  find_program(SOTN_LLDB NAMES lldb REQUIRED)
  set(command "${SOTN_LLDB}" --batch -o run -k "thread backtrace all" -- ${command})
endif()
execute_process(COMMAND ${command}
  WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.."
  RESULT_VARIABLE status COMMAND_ECHO STDOUT)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Game launch failed: ${status}")
endif()
